%{
  #include <stdlib.h>
  #include <stdio.h>
  #include <assert.h>
  #include <stdio.h>

static void yyerror (const char *msg);
  static int yylex (void);
  static void print_lookahead (char const *);
  static char merge (union YYSTYPE, union YYSTYPE);
  #define USE(value)
