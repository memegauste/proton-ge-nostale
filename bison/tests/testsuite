read_signed_integer (yy::parser::semantic_type *lvalp)
{
  int c = get_char (lvalp);
  int sign = 1;
  int n = 0;

  (void) lvalp;;
  if (c == '-')
    {
      c = get_char (lvalp);
      sign = -1;
    }

  while (isdigit (c))
    {
      n = 10 * n + (c - '0');
      c = get_char (lvalp);
    }

