static
void calcerror (YYLTYPE const * const llocp, semantic_value *result, int *count, const char *msg)
{
  YYUSE(result);
  YYUSE(count);
  LOCATION_PRINT (stderr, (*llocp));
  fprintf (stderr, ": ");
  fprintf (stderr, "%s\n", msg);
}
